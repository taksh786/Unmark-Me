# Local-only paths used by optional research and benchmark scripts.
# Copy this file to .env and set the paths for your machine.

GWR_ALLENK_ROOT=/path/to/GeminiWatermarkTool
GWR_SAMPLE_ROOT=/path/to/sample-files/gemini-watermark
GWR_VIDEO_SAMPLE_ROOT=/path/to/sample-files/gemini-video-watermark
GWR_DOWNLOAD_SAMPLE_ROOT=/path/to/downloaded-gemini-samples
GWR_SAMPLE_COLLECTOR=/path/to/sample-files/scripts/fetch_recent_online_samples.py

# Email sign-in (dev server and Vercel).
# DATABASE_URL: Postgres connection string. Locally: postgresql://localhost:5432/unmark_me
# AUTH_SECRET:  long random string used to hash sign-in codes. Required on Vercel.
# RESEND_API_KEY: Resend API key for sending codes. Without it, local dev prints the code in the server log.
# EMAIL_FROM:   sender, e.g. "Unmark Me <login@yourdomain.com>" (a domain verified in Resend).
DATABASE_URL=postgresql://localhost:5432/unmark_me
AUTH_SECRET=replace-with-a-long-random-string
RESEND_API_KEY=
EMAIL_FROM=
